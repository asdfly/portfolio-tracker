# 归档目录（旧脚本/临时文件，不需要版本控制）
archive/

# 环境变量
.env
.env.local
.env.QA_RESIDUE*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.pytest_cache/

# 虚拟环境
python-env/
venv/
.venv/

# 数据文件（数据库、报告、日志）
data/database/
data/reports/*
# 例外: run_report_<date>.json 是**机器可读的运行账本**(1~3KB/份), 记录本次运行
# 跑完没有(run_status)、dq_score 为何为 null、哪些源/阶段失败 —— 是事故复盘时
# 唯一的原始物证, 体量小且不可由库重生成。
# 2026-09-15 的事故(管线 rc=1 却写出 dq_score=100/alerts=[])之所以只能靠转录
# 进测试来留证, 正是因为该目录整体未纳入版本控制。故只放开这一种文件。
# 注意: 必须写成 data/reports/* 而非 data/reports/ —— 后者会排除目录本身,
# git 不再下探, 后面的 ! 规则失效; 而 *.html(100KB+, 可由库重生成) 继续被排除。
!data/reports/run_report_*.json
data/raw/
data/processed/
# westock-mcp 自动化每日落盘的实时缓存（覆盖写，避免每日 git 抖动；种子文件 etf_westock_<code>.json / cs932000_westock_*.json 照常提交）
scripts/backfill/data/*_latest.json
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Jupyter
.ipynb_checkpoints/

# 临时文件
*.tmp
*.bak
*.swp
timer_config.xml

# 临时测试/调试文件

# 输出文件（报告、截图）
output/

# 日志文件
dashboard_log.txt

# 数据库文件（即使空文件）
data/*.db
data/*.txt

# Dash环境
.streamlit/secrets.toml

